# Clerk (clerk.com) — App erstellen, Keys aus "API Keys" kopieren
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Lemon Squeezy (lemonsqueezy.com) — Store + Produkt/Variante anlegen
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Basis-URL der App (für Checkout-Redirects) — lokal meist unverändert lassen
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SEC EDGAR (sec.gov) — Fair-Access-Policy verlangt einen identifizierenden User-Agent
# Format: "AppName (contact@email.tld)"
SEC_EDGAR_USER_AGENT=

# Resend (resend.com) — für Watchlist-Alert-E-Mails. API-Key aus dem Dashboard, Absenderadresse
# muss zu einer in Resend verifizierten Domain gehören (oder testweise onboarding@resend.dev).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# OpenFIGI (openfigi.com) — kostenloser Key, für CUSIP->Ticker-Auflösung im 13F-Tracking
OPENFIGI_API_KEY=

# Twitter/X-Bot — dry-run (nur Log, kein echter Post), solange TWITTER_BOT_ENABLED=false oder
# einer der vier Credentials fehlt
TWITTER_BOT_ENABLED=false
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Turso (turso.tech) — ersetzt die lokale SQLite-Datei in Produktion (Vercel hat kein
# persistentes Dateisystem). `turso db create consensusiq` und `turso db tokens create consensusiq`
# lokal reicht ein eigenes zweites DB (z.B. `consensusiq-dev`), damit npm run dev nicht die
# echte Produktions-DB anfasst.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Shared secret für /api/cron/* — muss mit dem Wert übereinstimmen, den cron-job.org als
# "Authorization: Bearer <CRON_SECRET>"-Header mitschickt (Vercel's eigener Cron setzt ihn
# automatisch, wenn diese Variable in den Projekt-Settings gesetzt ist).
CRON_SECRET=
